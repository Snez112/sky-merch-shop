# API Security
# Optional: Add a secret key for additional API protection
# Generate a random string: openssl rand -base64 32
# API_SECRET=your-secret-key-here

# Base URL for your application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Sheets Configuration
NEXT_PUBLIC_GSHEET_WEBAPP_URL=your-google-sheet-webapp-url
NEXT_PUBLIC_GSHEET_WEBAPP_URL_DEV=your-google-sheet-webapp-url-dev
NEXT_PUBLIC_GSHEET_API_TOKEN=your-google-sheet-api-token

# API Token
NEXT_PUBLIC_API_TOKEN=your-api-token
